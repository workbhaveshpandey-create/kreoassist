rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is the specific admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "workbhaveshpandey@gmail.com";
    }

    match /feedback/{feedbackId} {
      // 1. PUBLIC SUBMISSION
      // Allow anyone (even unauthenticated users) to submit feedback
      allow create: if true;

      // 2. ADMIN DASHBOARD ACCESS
      // Only the specific admin email can read/list feedback
      allow read: if isAdmin();
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
